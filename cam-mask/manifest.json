{
  "manifest_version": 3,
  "name": "Cam Mask",
  "version": "1.1.0",
  "description": "Presents a synthetic or relayed camera to pages that inspect getUserMedia/enumerateDevices.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fake.webm", "fake.mp4"],
      "matches": ["<all_urls>"]
    }
  ]
}
